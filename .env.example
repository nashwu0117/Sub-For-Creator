# ============================================================
# Sub-For-Creator 环境变量模板
#
# 使用方法：
#   cp .env.example .env      （然后按需修改）
#
# 变量约定：
#   - 所有 SFC_ 前缀变量由后端统一读取（pydantic-settings）
#   - POSTGRES_* 仅供 docker-compose.yml 中的 postgres 服务使用
#   - VITE_API_BASE 仅供本地开发时 vite 使用
#
# 两种运行方式：
#   1. 本地开发：make api / make worker / make web
#   2. Docker 部署：make up（docker compose up -d --build）
#      compose 会用 environment 覆盖下述几个路径类变量
#      （SFC_DATABASE_URL / SFC_UPLOAD_DIR / SFC_CELERY_BROKER_URL 指向容器内服务）
# ============================================================

# ---------- 数据库 ----------
# 本地开发默认 SQLite（相对 backend/ 目录）。
# Docker 部署由 compose 覆盖为 sqlite:////data/app.db（持久化于 sfc-data 卷）。
# 生产如需 PostgreSQL：
#   1) 在 backend/requirements.txt 中追加 psycopg[binary]>=3.1（postgres 驱动）
#   2) 取消 docker-compose.yml 中 postgres 服务注释，并把本变量改为：
#      postgresql+psycopg://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/<POSTGRES_DB>
SFC_DATABASE_URL=sqlite:///./data/app.db

# 上传文件存储目录（本地开发用相对路径；compose 中固定为 /data/uploads，挂载 sfc-data 卷）
SFC_UPLOAD_DIR=./data/uploads

# 存储后端：local（本地磁盘）| s3（S3/R2 兼容对象存储）
SFC_STORAGE_BACKEND=local

# ---------- S3 / R2 对象存储（SFC_STORAGE_BACKEND=s3 时生效）----------
# 以 Cloudflare R2 为例（S3 兼容接口；AWS S3 填 https://s3.<region>.amazonaws.com）
SFC_S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
SFC_S3_BUCKET=sfc-uploads
SFC_S3_ACCESS_KEY=your_r2_access_key
SFC_S3_SECRET_KEY=your_r2_secret_key

# ---------- 资源限制 ----------
# 0 = 不限制。以下默认全部无限制（可按部署需求自行设置）。
# 单文件上传大小上限（MB）。0 = 无限制
SFC_MAX_UPLOAD_MB=0
# 单个视频最大时长（分钟）。0 = 无限制
SFC_MAX_DURATION_MIN=0
# 单会话每日可处理视频总时长（秒）。0 = 无限制
SFC_DAILY_SECONDS_PER_SESSION=0
# 任务队列最大长度（超出的请求直接拒绝）。0 = 无限制
SFC_MAX_QUEUE=0
# 最大并发任务数（建议与 worker --concurrency 保持一致）
SFC_MAX_CONCURRENT=2
# 任务结果保留时长（小时），到期自动清理
SFC_TTL_HOURS=48
# 上传限流：每个 session 每 60 秒窗口内最多允许的上传次数（整数）。0 = 无限制
SFC_UPLOAD_RATE_LIMIT=0
# 自定义字体上传大小上限（MB）。0 = 无限制
SFC_MAX_FONT_MB=0
# MP4 / WebM 背景渲染超时（秒）。长片或 4K 建议不低于 3600
SFC_RENDER_TIMEOUT_SECONDS=3600

# ---------- 队列 / Celery ----------
# 队列后端：celery（默认，需 Redis broker）| inline（进程内线程池，无需 Redis）
SFC_QUEUE_BACKEND=celery
# Celery broker 地址：compose 内为 redis://redis:6379/0（服务名）；
# 本地开发请改为 redis://localhost:6379/0
SFC_CELERY_BROKER_URL=redis://localhost:6379/0
# 多队列拓扑的队列名（celery_app.task_routes 使用）。修改后必须同步
# 所有 worker 命令的 -Q 参数（见 docs/DEPLOY-MULTI-GPU.md）
SFC_DEFAULT_QUEUE=celery
SFC_TRANSCRIBE_QUEUE=transcribe
SFC_RENDER_QUEUE=render

# ---------- 多 GPU 横向扩展 ----------
# 0-based GPU 索引：设置后 worker 进程通过 CUDA_VISIBLE_DEVICES 绑定到该 GPU。
# 留空 = 不绑定（单 GPU 主机看到全部设备）。仅 worker 容器需要设置；
# 多 worker 共用一张 GPU 时（int8 large-v3 约 8GB）可设相同值。
SFC_GPU_INDEX=

# ---------- ASR / 字幕 ----------
# WhisperX 模型：tiny / base / small / medium / large-v3
#（GPU 推荐 large-v3；CPU 上建议 small，否则极慢）
SFC_WHISPERX_MODEL=large-v3
# faster-whisper 模型（faster-whisper 后端时生效）：tiny / base / small / medium / large-v3
SFC_WHISPER_MODEL=small
# 识别后端：whisperx | faster-whisper | mock（mock 用于无模型联调）
SFC_ASR_BACKEND=whisperx
# 字幕单行最大字符数（超出自动断行）；中文默认 16，拉丁语系可调至 40
SFC_MAX_LINE_CHARS=16
# 准确度分级：lite | standard | pro（预设模型/beam/VAD，见 app/core/asr.py TIER_PRESETS）
SFC_TIER=standard
# 解码 beam 大小；不设置 = 用分级预设（lite/standard=5，pro=10）。要覆盖请取消注释：
# SFC_BEAM_SIZE=10
# 解码温度；不设置 = 用分级预设（0 = 确定性输出）。要覆盖请取消注释：
# SFC_TEMPERATURE=0
# 语音活动检测（VAD）；不设置 = 用分级预设（默认开启）。要覆盖请取消注释：
# SFC_VAD_ENABLED=false
# 降噪（noisereduce）；不设置 = 用分级预设（standard/pro 开启，lite 关闭）。要覆盖请取消注释：
# SFC_DENOISE_ENABLED=true
# 响度归一化（loudnorm）；不设置 = 用分级预设（standard/pro 开启，lite 关闭）。要覆盖请取消注释：
# SFC_LOUDNORM_ENABLED=true
# 降噪强度（noisereduce prop_decrease，0~1）
SFC_NOISE_REDUCTION_STRENGTH=0.75
# 用户词典路径（用于 initial_prompt 与 LLM 校正）
SFC_DICTIONARY_PATH=./data/user_dictionary.json
# initial_prompt 最大字符数
SFC_INITIAL_PROMPT_MAX_CHARS=1500
# LLM 校正；不设置 = 用分级预设（pro 开启，lite/standard 关闭）。要覆盖请取消注释：
# SFC_LLM_CORRECTION_ENABLED=true
# LLM 提供商：ollama | openai
SFC_LLM_PROVIDER=ollama
# Ollama 服务地址
SFC_OLLAMA_URL=http://localhost:11434
# OpenAI 兼容 API key（provider=openai 时必填）
SFC_LLM_API_KEY=
# LLM 模型名
SFC_LLM_MODEL=qwen2.5:7b
# LLM 请求超时（秒）
SFC_LLM_TIMEOUT_SECONDS=120

# ---------- 监控（Prometheus）----------
# 是否开放 GET /api/metrics（Prometheus 文本格式）。false 时端点返回 404
SFC_METRICS_ENABLED=true

# ---------- 账号系统（v2）----------
# 认证 cookie 名称
SFC_AUTH_COOKIE_NAME=sfc_session
# 认证 cookie 是否带 Secure 标记（HTTPS 部署时设为 true）
SFC_AUTH_COOKIE_SECURE=false
# 签名认证 cookie 的 HMAC-SHA256 secret（生产环境务必更换）
SFC_AUTH_SECRET=sfc-dev-secret-change-me
# 认证 cookie 有效期（天）
SFC_AUTH_SESSION_DAYS=30

# ---------- CORS ----------
# 逗号分隔的允许来源列表。
# Docker 部署走 nginx 同源代理，无需配置；
# 本地开发（vite :5173 调用后端 :8000）时需要放开：
SFC_CORS_ORIGINS=http://localhost:5173

# ---------- PostgreSQL（仅 docker-compose 启用 postgres 服务时使用）----------
POSTGRES_USER=sfc
POSTGRES_PASSWORD=sfc_change_me
POSTGRES_DB=sfc

# ---------- 前端 ----------
# 仅本地开发时由 vite 使用；Docker 构建不读取该变量（nginx 负责 /api 反向代理）
VITE_API_BASE=http://localhost:8000/api
