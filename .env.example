# ============================================================
# Sub-For-Creator 环境变量模板
#
# 使用方法：
#   cp .env.example .env      （然后按需修改）
#
# 变量约定：
#   - 所有 SFC_ 前缀变量由后端统一读取（pydantic-settings）
#   - POSTGRES_* 仅供 docker-compose.yml 中的 postgres 服务使用
#   - VITE_API_BASE 仅供本地开发时 vite 使用
#
# 两种运行方式：
#   1. 本地开发：make api / make worker / make web
#   2. Docker 部署：make up（docker compose up -d --build）
#      compose 会用 environment 覆盖下述几个路径类变量
#      （SFC_DATABASE_URL / SFC_UPLOAD_DIR / SFC_CELERY_BROKER_URL 指向容器内服务）
# ============================================================

# ---------- 数据库 ----------
# 本地开发默认 SQLite（相对 backend/ 目录）。
# Docker 部署由 compose 覆盖为 sqlite:////data/app.db（持久化于 sfc-data 卷）。
# 生产如需 PostgreSQL：
#   1) 在 backend/requirements.txt 中追加 psycopg[binary]>=3.1（postgres 驱动）
#   2) 取消 docker-compose.yml 中 postgres 服务注释，并把本变量改为：
#      postgresql+psycopg://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/<POSTGRES_DB>
SFC_DATABASE_URL=sqlite:///./data/app.db

# 上传文件存储目录（本地开发用相对路径；compose 中固定为 /data/uploads，挂载 sfc-data 卷）
SFC_UPLOAD_DIR=./data/uploads

# 存储后端：local（本地磁盘）| s3（S3/R2 兼容对象存储）
SFC_STORAGE_BACKEND=local

# ---------- S3 / R2 对象存储（SFC_STORAGE_BACKEND=s3 时生效）----------
# 以 Cloudflare R2 为例（S3 兼容接口；AWS S3 填 https://s3.<region>.amazonaws.com）
SFC_S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
SFC_S3_BUCKET=sfc-uploads
SFC_S3_ACCESS_KEY=your_r2_access_key
SFC_S3_SECRET_KEY=your_r2_secret_key

# ---------- 资源限制 ----------
# 单文件上传大小上限（MB）。注意 nginx client_max_body_size 已设为 2g，请勿超过 ~2048
SFC_MAX_UPLOAD_MB=1024
# 单个视频最大时长（分钟）
SFC_MAX_DURATION_MIN=120
# 单会话每日可处理视频总时长（秒）
SFC_DAILY_SECONDS_PER_SESSION=3600
# 任务队列最大长度（超出的请求直接拒绝）
SFC_MAX_QUEUE=50
# 最大并发任务数（建议与 worker --concurrency 保持一致）
SFC_MAX_CONCURRENT=2
# 任务结果保留时长（小时），到期自动清理
SFC_TTL_HOURS=24
# 上传限流：每个 session 每 60 秒窗口内最多允许的上传次数（整数）
SFC_UPLOAD_RATE_LIMIT=10

# ---------- 队列 / Celery ----------
# 队列后端：celery（默认）| redis
SFC_QUEUE_BACKEND=celery
# Celery broker 地址：compose 内为 redis://redis:6379/0（服务名）；
# 本地开发请改为 redis://localhost:6379/0
SFC_CELERY_BROKER_URL=redis://localhost:6379/0

# ---------- ASR / 字幕 ----------
# WhisperX 模型：tiny / base / small / medium / large-v3
#（GPU 推荐 large-v3；CPU 上建议 small，否则极慢）
SFC_WHISPERX_MODEL=large-v3
# 识别后端：whisperx | faster-whisper | mock（mock 用于无模型联调）
SFC_ASR_BACKEND=whisperx
# 字幕单行最大字符数（超出自动断行）
SFC_MAX_LINE_CHARS=80

# ---------- CORS ----------
# 逗号分隔的允许来源列表。
# Docker 部署走 nginx 同源代理，无需配置；
# 本地开发（vite :5173 调用后端 :8000）时需要放开：
SFC_CORS_ORIGINS=http://localhost:5173

# ---------- PostgreSQL（仅 docker-compose 启用 postgres 服务时使用）----------
POSTGRES_USER=sfc
POSTGRES_PASSWORD=sfc_change_me
POSTGRES_DB=sfc

# ---------- 前端 ----------
# 仅本地开发时由 vite 使用；Docker 构建不读取该变量（nginx 负责 /api 反向代理）
VITE_API_BASE=http://localhost:8000/api
